# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 凭据防御性忽略（本仓库不包含任何真实密钥）
# 脚本中的密钥均以 ${OPENROUTER_API_KEY} / ${MINIMAX_API_KEY} 形式从环境变量读取
.env
.env.*
.secrets
*.pem
*.key
id_rsa*
credentials*

# 本地代理/会话工作目录及运行日志
.pi/
*.log

