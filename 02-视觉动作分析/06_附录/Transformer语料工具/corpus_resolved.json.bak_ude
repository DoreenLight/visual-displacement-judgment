      "canonical_title": "Byte Latent Transformer: Patches Scale Better Than Tokens",
      "arxiv_id": "2412.09871v1",
      "authors": [
        "Artidoro Pagnoni",
        "Ram Pasunuru",
        "Pedro Rodriguez",
        "John Nguyen",
        "Benjamin Muller",
        "Margaret Li",
        "Chunting Zhou",
        "Lili Yu",
